{
    "version": "0.2.0",
    "configurations": [
        {
            // Le jeu, comme jeu/lancer.sh : lance depuis jeu/ pour que le dossier ressources soit trouve.
            "type": "java",
            "name": "GET A JOB",
            "request": "launch",
            "mainClass": "jeu.Fenetre",
            "args": "ressources",
            "cwd": "${workspaceFolder}/jeu"
        },
        {
            // Avec l'aide au test (M ou F2) et la partie de test a part, comme jeu/dev/lancer.sh.
            "type": "java",
            "name": "GET A JOB (aide au test)",
            "request": "launch",
            "mainClass": "jeu.Fenetre",
            "args": "ressources",
            "vmArgs": "-Dgaj.dev=true",
            "cwd": "${workspaceFolder}/jeu"
        }
    ]
}
