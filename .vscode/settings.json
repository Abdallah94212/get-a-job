{
    // Le projet Java : les sources du jeu, les tests, et JUnit (seule bibliotheque, pour les tests).
    "java.project.sourcePaths": ["src", "tests"],
    "java.project.referencedLibraries": ["lib/**/*.jar"],
    "java.project.outputPath": "build/vscode",
    "files.encoding": "utf8",
    "files.exclude": {
        "build": true,
        "build-tests": true
    }
}
