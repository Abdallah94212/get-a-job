{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lancer le jeu",
            "type": "shell",
            "command": "bash jeu/lancer.sh",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Lancer les tests",
            "type": "shell",
            "command": "bash jeu/tester.sh",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        }
    ]
}
